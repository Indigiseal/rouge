desktop.ini
Thumbs.db
node_modules/
sim/db/*.sqlite
sim/db/*.sqlite-*
sim/output/

# Build output and packaged builds. These are generated from src/, so they do
# not belong in history — and a committed build zip makes every diff unreadable
# for anyone reviewing the actual code.
dist/
*.zip
make_itch_zip.py

# Sim result dumps. Generated by sim/balance-sim.js; keep the ones you want to
# discuss by committing them deliberately (git add -f sim/whatever.json), but
# don't let a bulk `git add -A` sweep in a few dozen run outputs.
sim/*.json
sim/*.md
!sim/METRICS-CATALOG.md
!sim/README.md

# Uncompressed audio masters, ~57MB of WAV. Kept locally and backed up outside
# git; the game loads the exported assets/music/*.mp3, which stay tracked.
assets/_masters/

# Taya's personal art scratch folder. Sources, layer dumps, half-finished
# sprites — never meant to ship or be reviewed.
assets/art/wip/

# ElevenLabs sound takes to audition (tools/generate-death-sounds.mjs). Only the
# chosen ones are copied into assets/music/ and committed.
assets/_sfx_takes/

# Audio the game no longer loads, kept to reach for later: alternate music,
# the old shared family death sounds, retired clicks. Not shipped, not loaded.
assets/_archive/

# Generated QA screenshots/scripts, Python caches and PixelLab concept dumps: local scratch.
__pycache__/
output/
assets/art/*-candidates/
assets/art/*-prototypes/
assets/art/*-structures/
