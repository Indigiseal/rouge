desktop.ini
Thumbs.db
node_modules/
sim/db/*.sqlite
sim/db/*.sqlite-*
sim/output/

# Build output and packaged builds. These are generated from src/, so they do
# not belong in history — and a committed build zip makes every diff unreadable
# for anyone reviewing the actual code.
dist/
*.zip

# Sim result dumps. Generated by sim/balance-sim.js; keep the ones you want to
# discuss by committing them deliberately (git add -f sim/whatever.json), but
# don't let a bulk `git add -A` sweep in a few dozen run outputs.
sim/*.json
